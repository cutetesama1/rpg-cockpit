{
  "$defs": {
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "damage",
            "heal",
            "add_stat",
            "set_stat",
            "add_item",
            "set_flag",
            "enter_scene",
            "learn_skill",
            "learn_catalog_skills",
            "update_clothing",
            "update_portrait",
            "set_value",
            "record_fact",
            "update_worldbook",
            "roll",
            "acquire_item",
            "credit_currency"
          ],
          "title": "Name",
          "type": "string"
        },
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "evidence": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "source": {
          "default": "narrative",
          "enum": [
            "narrative",
            "skill_cost"
          ],
          "title": "Source",
          "type": "string"
        },
        "estimated": {
          "default": false,
          "title": "Estimated",
          "type": "boolean"
        },
        "estimate_reason": {
          "default": "",
          "maxLength": 500,
          "title": "Estimate Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "evidence"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Pending": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "reason": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "maxLength": 500,
          "title": "Evidence",
          "type": "string"
        },
        "visibility": {
          "default": "public",
          "enum": [
            "public",
            "internal"
          ],
          "title": "Visibility",
          "type": "string"
        },
        "question": {
          "default": "",
          "maxLength": 300,
          "title": "Question",
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/Operation"
          },
          "maxItems": 20,
          "title": "Operations",
          "type": "array"
        },
        "status_patch": {
          "additionalProperties": true,
          "title": "Status Patch",
          "type": "object"
        }
      },
      "required": [
        "title",
        "reason"
      ],
      "title": "Pending",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked": {
      "description": "逐项检查八个领域后填写：stats,status,inventory,flags,skills,wardrobe,scene,action",
      "items": {
        "type": "string"
      },
      "title": "Checked",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "maxItems": 80,
      "title": "Operations",
      "type": "array"
    },
    "status_patch": {
      "additionalProperties": true,
      "title": "Status Patch",
      "type": "object"
    },
    "uncertain": {
      "description": "无法从正文或目录确定的事项及原因；关闭模糊鉴定时不猜测；开启时按协议给有依据的估值或物品草案，不阻止其他已确认变化提交",
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Uncertain",
      "type": "array"
    },
    "pending": {
      "description": "有歧义且需要玩家裁定的事项；草案不自动执行，不得与 operations 重复结算",
      "items": {
        "$ref": "#/$defs/Pending"
      },
      "maxItems": 20,
      "title": "Pending",
      "type": "array"
    }
  },
  "required": [
    "checked"
  ],
  "title": "Proposal",
  "type": "object"
