{
  "$defs": {
    "LlmProfile": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "scripted",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "temperature": {
          "default": 0.7,
          "title": "Temperature",
          "type": "number"
        },
        "max_tokens": {
          "default": 0,
          "title": "Max Tokens",
          "type": "integer"
        }
      },
      "title": "LlmProfile",
      "type": "object"
    },
    "LlmRolesConfig": {
      "additionalProperties": false,
      "description": "一期：narrator 与 settler 指向同一 profile，separated=False。\n\n拆分多 LLM 只改这里：separated=True + settler 指向小模型，核心契约不变。",
      "properties": {
        "separated": {
          "default": false,
          "title": "Separated",
          "type": "boolean"
        },
        "narrator": {
          "$ref": "#/$defs/LlmProfile"
        },
        "settler": {
          "$ref": "#/$defs/LlmProfile"
        },
        "arbiter": {
          "$ref": "#/$defs/LlmProfile"
        },
        "setup": {
          "$ref": "#/$defs/LlmProfile"
        },
        "director": {
          "$ref": "#/$defs/LlmProfile"
        },
        "corrector": {
          "anyOf": [
            {
              "$ref": "#/$defs/LlmProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "voice_cast": {
          "anyOf": [
            {
              "$ref": "#/$defs/LlmProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LlmRolesConfig",
      "type": "object"
    },
    "ProviderSettings": {
      "additionalProperties": false,
      "description": "一个模型端点的连接信息。api_key 只存后端，接口返回时打码。",
      "properties": {
        "base_url": {
          "default": "",
          "title": "Base Url",
          "type": "string"
        },
        "api_key": {
          "default": "",
          "title": "Api Key",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "preset": {
          "default": "",
          "title": "Preset",
          "type": "string"
        },
        "reasoning_effort": {
          "default": "",
          "title": "Reasoning Effort",
          "type": "string"
        },
        "timeout": {
          "default": 60,
          "title": "Timeout",
          "type": "number"
        },
        "price_in": {
          "default": 0,
          "minimum": 0,
          "title": "Price In",
          "type": "number"
        },
        "price_out": {
          "default": 0,
          "minimum": 0,
          "title": "Price Out",
          "type": "number"
        },
        "max_retries": {
          "default": 2,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "retry_backoff_ms": {
          "default": 500,
          "maximum": 10000,
          "minimum": 0,
          "title": "Retry Backoff Ms",
          "type": "integer"
        }
      },
      "title": "ProviderSettings",
      "type": "object"
    },
    "SettlementSettings": {
      "additionalProperties": false,
      "properties": {
        "relaxed_validation": {
          "default": true,
          "title": "Relaxed Validation",
          "type": "boolean"
        },
        "fuzzy_identification": {
          "default": false,
          "title": "Fuzzy Identification",
          "type": "boolean"
        },
        "confirm_item_gains": {
          "default": true,
          "title": "Confirm Item Gains",
          "type": "boolean"
        }
      },
      "title": "SettlementSettings",
      "type": "object"
    },
    "VoiceSettings": {
      "additionalProperties": false,
      "description": "Compatible speech API; secrets never leave the backend.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "mode": {
          "default": "imported",
          "enum": [
            "imported",
            "automatic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "base_url": {
          "default": "",
          "maxLength": 2000,
          "title": "Base Url",
          "type": "string"
        },
        "api_key": {
          "default": "",
          "maxLength": 4000,
          "title": "Api Key",
          "type": "string"
        },
        "model": {
          "default": "",
          "maxLength": 200,
          "title": "Model",
          "type": "string"
        },
        "voice": {
          "default": "alloy",
          "maxLength": 200,
          "minLength": 1,
          "title": "Voice",
          "type": "string"
        },
        "speed": {
          "default": 1,
          "maximum": 4,
          "minimum": 0.25,
          "title": "Speed",
          "type": "number"
        },
        "timeout": {
          "default": 60,
          "maximum": 180,
          "minimum": 1,
          "title": "Timeout",
          "type": "number"
        },
        "provider": {
          "default": "openai",
          "enum": [
            "openai",
            "elevenlabs"
          ],
          "title": "Provider",
          "type": "string"
        }
      },
      "title": "VoiceSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "持久化模型设置：角色 → profile，provider 名 → 端点信息。\n\nprovider 名为 \"scripted\" 时走内置脚本假模型；其余按 OpenAI 兼容端点调用，\n默认只有一个名为 \"openai\" 的端点槽位，接 DeepSeek / LM Studio / vLLM 都填这里。",
  "properties": {
    "settlement": {
      "$ref": "#/$defs/SettlementSettings"
    },
    "speech": {
      "$ref": "#/$defs/VoiceSettings"
    },
    "roles": {
      "$ref": "#/$defs/LlmRolesConfig"
    },
    "providers": {
      "additionalProperties": {
        "$ref": "#/$defs/ProviderSettings"
      },
      "title": "Providers",
      "type": "object"
    }
  },
  "title": "LlmSettings",
  "type": "object"
}
