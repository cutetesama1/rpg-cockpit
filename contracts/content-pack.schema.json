    "SpriteCrop": {
      "additionalProperties": false,
      "description": "素材里的有效区域（像素）。\n\nDoL 的立绘 PNG 是 512×256 的大图，真正的角色只占左上角一小块，右侧另有一块\n放大预览；整张画会重影。`crop` 指定从每层图片的哪一块取样，所有图层共用同一\n窗口，再等比放大到画布。",
      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "default": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "default": 0,
          "title": "H",
          "type": "integer"
        }
      },
      "title": "SpriteCrop",
      "type": "object"
    },
    "SpriteLayer": {
      "additionalProperties": false,
      "description": "立绘的一层：图片路径 + 层序 + 显示条件 + 着色/遮罩。\n\n`src` 是相对内容包根目录的路径模板，可以用 `{field}` 引用状态字段，\n例如 `ui/sprites/body/base-{body_type}.png`；字段值会原样替换。",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "src": {
          "title": "Src",
          "type": "string"
        },
        "z": {
          "default": 0,
          "title": "Z",
          "type": "integer"
        },
        "when": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
