          "type": "array"
        },
        "unless": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Unless",
          "type": "array"
        },
        "tint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tint"
        },
        "tint_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tint Field"
        },
        "opacity": {
          "default": 1.0,
          "title": "Opacity",
          "type": "number"
        },
        "wear_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wear Field"
        },
        "blend": {
          "default": "normal",
          "enum": [
            "normal",
            "multiply"
          ],
          "title": "Blend",
          "type": "string"
        },
        "mask": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask"
        },
        "x": {
          "default": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "integer"
        },
        "adult": {
          "default": false,
          "title": "Adult",
          "type": "boolean"
        },
        "space": {
          "default": "character",
          "enum": [
            "character",
            "background",
            "foreground"
          ],
          "title": "Space",
          "type": "string"
        }
      },
      "required": [
        "id",
        "src"
      ],
      "title": "SpriteLayer",
      "type": "object"
    },
    "SpritePose": {
      "additionalProperties": false,
      "description": "一种姿势：自己的取样窗口 + 图层列表。\n\n立绘默认用 `SpriteSheet.layers`；当状态字段 `pose` 的值等于某个姿势名时，\n改用该姿势的窗口和图层。DoL 的坐/卧/性交姿势都是独立的一套图层，\n取样窗口也和站姿不同，所以每个姿势自带 `crop`。",
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpriteCrop"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/SpriteLayer"
          },
          "title": "Layers",
          "type": "array"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "frames": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frames"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fps"
        },
        "frame_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Width"
        }
      },
      "title": "SpritePose",
      "type": "object"
    },
    "SpriteRule": {
      "additionalProperties": false,
      "description": "状态联动规则：满足 `when` 时把若干字段替换成 `set` 里的值再画。\n\n只影响绘制，不改状态本身（不写账本）——「受伤时换成 hurt 表情」这类\n表现层联动适合放这里；真要改数值请用调试台或剧情事件。",
      "properties": {
        "when": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "When",
          "type": "array"
        },
        "set": {
          "additionalProperties": true,
          "title": "Set",
          "type": "object"
        }
      },
      "title": "SpriteRule",
      "type": "object"
    },
