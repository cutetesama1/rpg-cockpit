{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narrative Cockpit",
  "version": "0.4.0",
  "identifier": "com.rpgframework.cockpit",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/rpg-sidecar.exe": "rpg-sidecar.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
