{
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "rpg.skill-library",
      "title": "Type",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Version",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 1000,
      "title": "Description",
      "type": "string"
    },
    "resources": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Resources",
      "type": "object"
    }
  },
  "required": [
    "type",
    "id",
    "title",
    "version"
  ],
  "title": "SkillLibraryManifest",
  "type": "object"
}
